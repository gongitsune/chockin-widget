{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chockin-widget-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-17",
  "vars": {
    "CACHE_TTL": "600",
    "API_URL": "https://chockin.dev/api/v1",
  },
  "cache": {
    "enabled": true,
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  },
  "upload_source_maps": true
}
